rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isApproved() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // Users collection - read by authenticated users, write by self or admin
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId || isAdmin();
      allow create: if isAuthenticated();
    }

    // Products collection - read by all, write by admin or approved staff
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || isApproved();
    }

    // Orders collection - read by all authenticated, write by admin or self
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && isApproved());
    }

    // Employees collection - read by admin, write by admin
    match /employees/{employeeId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Expenses collection - read by admin, write by admin
    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Analytics collection - read by admin
    match /analytics/{analyticsId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // CMS Content - public read, admin write
    match /cms_content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Testimonials - public read, admin write
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Features - public read, admin write
    match /features/{featureId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Daily Sales collection - read and write by admin or approved staff
    match /daily_sales/{saleId} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin() || isApproved();
    }

    // Staff Reports collection - read by admin, write by approved staff
    match /staff_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if isApproved();
    }

    // Catch-all for any other collections - deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
